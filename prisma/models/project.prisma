// use prisma-8

enum ProjectStatus {
  @@type("pg/text@1")
  DRAFT = "DRAFT"
  ARCHIVED = "ARCHIVED"
}

// Project.id is an app-generated slug-suffix string (e.g. "pricing-page-a1b2")
// that doubles as the /editor/[roomId] URL segment and the Liveblocks room ID
// (slug-based ID decision, 2026-10-28). The client previews and supplies the
// value so the project ID and room ID are identical at creation time.
model Project {
  id             String                  @id
  ownerId        String
  name           String
  description    String?
  status         ProjectStatus           @default(DRAFT)
  canvasJsonPath String?
  createdAt      temporal.CreatedAtJsDate
  updatedAt      temporal.UpdatedAtJsDate
  collaborators  ProjectCollaborator[]

  @@index([ownerId])
  @@index([createdAt])
}

model ProjectCollaborator {
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  email     String
  createdAt temporal.CreatedAtJsDate

  @@id([projectId, email])
  @@index([email])
  @@index([projectId, createdAt])
}
